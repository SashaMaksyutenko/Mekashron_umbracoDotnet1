      },
      "introText": {
        "en-US": "{\u0022markup\u0022:\u0022\\u003Cp style=\\u0022text-align: center;\\u0022\\u003E\\u003Cspan style=\\u0022color: rgb(85, 94, 115); font-family: Inter, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\\u0022\\u003EPlease fill in the form below to download your free trial.\\u003C/span\\u003E\\u003Cbr\\u003E\\u003Cspan style=\\u0022color: rgb(85, 94, 115); font-family: Inter, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\\u0022\\u003EWe will only use this information to tell you about upgrades and other product-related announcements.\\u003C/span\\u003E\\u003Cbr\\u003E\\u003Cspan style=\\u0022color: rgb(85, 94, 115); font-family: Inter, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\\u0022\\u003EYou can unsubscribe at any time.\\u003C/span\\u003E\\u003C/p\\u003E\\u003Cp style=\\u0022text-align: center;\\u0022\\u003E\\u003Cspan style=\\u0022color: rgb(128, 0, 0); font-family: Inter, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\\u0022\\u003EYour email address will remain completely confidential and will not be shared with any another parties or placed on any mailing lists.\\u003C/span\\u003E\\u003C/p\\u003E\u0022,\u0022blocks\u0022:{\u0022contentData\u0022:[],\u0022settingsData\u0022:[],\u0022expose\u0022:[],\u0022Layout\u0022:{}}}",
        "ru": "{\u0022markup\u0022:\u0022\\u003Cp style=\\u0022text-align: center;\\u0022\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E\\u041F\\u043E\\u0436\\u0430\\u043B\\u0443\\u0439\\u0441\\u0442\\u0430, \\u0437\\u0430\\u043F\\u043E\\u043B\\u043D\\u0438\\u0442\\u0435 \\u0444\\u043E\\u0440\\u043C\\u0443 \\u043D\\u0438\\u0436\\u0435, \\u0447\\u0442\\u043E\\u0431\\u044B \\u0441\\u043A\\u0430\\u0447\\u0430\\u0442\\u044C \\u0431\\u0435\\u0441\\u043F\\u043B\\u0430\\u0442\\u043D\\u0443\\u044E \\u043F\\u0440\\u043E\\u0431\\u043D\\u0443\\u044E \\u0432\\u0435\\u0440\\u0441\\u0438\\u044E.\\u003C/span\\u003E\\u003Cspan class=\\u0022Apple-converted-space\\u0022\\u003E\\u0026nbsp;\\u003C/span\\u003E\\u003Cspan class=\\u0022s1\\u0022\\u003E \\u041C\\u044B \\u0438\\u0441\\u043F\\u043E\\u043B\\u044C\\u0437\\u0443\\u0435\\u043C \\u044D\\u0442\\u0443 \\u0438\\u043D\\u0444\\u043E\\u0440\\u043C\\u0430\\u0446\\u0438\\u044E \\u0442\\u043E\\u043B\\u044C\\u043A\\u043E \\u0434\\u043B\\u044F \\u0443\\u0432\\u0435\\u0434\\u043E\\u043C\\u043B\\u0435\\u043D\\u0438\\u0439 \\u043E\\u0431 \\u043E\\u0431\\u043D\\u043E\\u0432\\u043B\\u0435\\u043D\\u0438\\u044F\\u0445 \\u0438 \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043D\\u043E\\u0432\\u043E\\u0441\\u0442\\u044F\\u0445, \\u0441\\u0432\\u044F\\u0437\\u0430\\u043D\\u043D\\u044B\\u0445 \\u0441 \\u043F\\u0440\\u043E\\u0434\\u0443\\u043A\\u0442\\u043E\\u043C.\\u0412\\u044B \\u043C\\u043E\\u0436\\u0435\\u0442\\u0435 \\u043E\\u0442\\u043A\\u0430\\u0437\\u0430\\u0442\\u044C\\u0441\\u044F \\u043E\\u0442 \\u043F\\u043E\\u0434\\u043F\\u0438\\u0441\\u043A\\u0438 \\u0432 \\u043B\\u044E\\u0431\\u043E\\u0435 \\u0432\\u0440\\u0435\\u043C\\u044F.\\u003C/span\\u003E\\u003C/p\\u003E\\u003Cp style=\\u0022text-align: center;\\u0022\\u003E\\u003C/p\\u003E\u0022,\u0022blocks\u0022:{\u0022contentData\u0022:[],\u0022settingsData\u0022:[],\u0022expose\u0022:[],\u0022Layout\u0022:{}}}"
