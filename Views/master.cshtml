@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent;
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>@Model.Value("pageTitle", fallback: Fallback.ToAncestors)</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <div class="site" id="page">

        <!-- Header -->
        <header class="header">
            <div class="container">
                <div class="header__inner">
                    <button class="burger" id="burgerButton">
                        <img src="/images/icons/burger.svg" alt="menu" />
                    </button>
                    <a href="/" class="logo">Mekashron</a>
                    <nav class="header__navigation navigation">
                        <ul class="navigation__list">
                            <li class="menu-item"><a href="/download">Solutions</a></li>
                            <li class="menu-item"><a href="/delivery">Products</a></li>
                            <li class="menu-item"><a href="/blog">Industries</a></li>
                            <li class="menu-item"><a href="/payment">About</a></li>
                            <li class="menu-item"><a href="/payment">Contacts</a></li>
                        </ul>
                    </nav>
                    <div class="header__actions row">
                        <a href="#" class="button">Get in Touch</a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Mobile Navigation -->
        <div class="mobile__nav">
            <header class="header">
                <div class="container">
                    <div class="header__inner">
                        <button class="icon close" id="closeMenu">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                      d="M12.0001 9.8183L2.18182 0L0 2.18182L9.8183 12.0001L0.000232995 21.8182L2.18205 24L12.0001 14.1819L21.8182 24L24 21.8182L14.1819 12.0001L24.0002 2.18182L21.8184 0L12.0001 9.8183Z"
                                      fill="white" />
                            </svg>
                        </button>
                        <a href="/" class="logo">Mekashron</a>
                        <div class="header__actions row">
                            <a href="#" class="button">Get in Touch</a>
                        </div>
                    </div>
                </div>
            </header>
            <nav class="nav" role="navigation" aria-label="mobile navigation">
                <ul class="navigation__list">
                    <li class="menu-item"><a href="/download">Solutions</a></li>
                    <li class="menu-item"><a href="/delivery">Products</a></li>
                    <li class="menu-item"><a href="/blog">Industries</a></li>
                    <li class="menu-item"><a href="/payment">About</a></li>
                    <li class="menu-item"><a href="/payment">Contacts</a></li>
                </ul>
            </nav>
        </div>

        <!-- Main Content -->
        <main class="main" id="primary">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="container">
                <div class="footer__inner">
                    <div class="column">
                        <a href="/" class="logo">Mekashron</a>
                        <p>
                            <b>Boost Efficiency, Cut Costs, and Accelerate Growth</b><br />
                            Powered by AI partner with 20 years of experience,<br />
                            you can <b>Trust</b>
                        </p>
                    </div>
                    <div class="column">
                        <div class="footer__actions">
                            <nav class="footer__nav">
                                <ul class="footer__nav--list">
                                    <li><a href="/delivery">Products</a></li>
                                    <li><a href="/download">Solutions</a></li>
                                    <li><a href="/payment">About</a></li>
                                    <li><a href="/blog">Industries</a></li>
                                    <li><a href="/payment">Contact</a></li>
                                </ul>
                            </nav>
                            <div class="column">
                                <nav class="footer__links">
                                    <ul class="footer__links--list">
                                        <li>
                                            <a href="https://wa.me/#" target="_blank">
                                                <img src="/images/icons/whatsapp-icon.svg" alt="whatsapp" />
                                                Contact us by WhatsApp
                                            </a>
                                        </li>
                                        <li>
                                            <a href="mailto:info@mekashron.com">
                                                <img src="/images/icons/mail.svg" alt="mail" />
                                                info@mekashron.com
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="language" id="language_btn">
                                    <ul id="language-menu" class="language__list">
                                        <li>
                                            <a href="#">
                                                <img src="/images/icons/country/USA.svg" alt="USA" width="16" height="11" />
                                                <span>English</span>
                                            </a>
                                            <ul class="sub-menu">
                                                <li><a href="#"><span>English</span></a></li>
                                                <li><a href="#"><span>Українська</span></a></li>
                                                <li><a href="#"><span>Русский</span></a></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="copy">
                    <p>© @DateTime.Now.Year Mekashron. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <script src="/js/swiper-bundle.min.js"></script>
    <script src="/js/select.js"></script>
    <script src="/js/scripts.js"></script>
</body>
</html>